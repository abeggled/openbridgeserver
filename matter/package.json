{
  "name": "matterbridge-obs",
  "version": "0.1.0",
  "description": "Matterbridge dynamic platform plugin bridging open bridge server DataPoints into Matter (Apple Home, Google Home, Alexa, SmartThings)",
  "author": "abeggled and all contributors",
  "license": "MIT",
  "homepage": "https://github.com/abeggled/openbridgeserver",
  "type": "module",
  "main": "dist/module.js",
  "types": "dist/module.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module.js",
      "types": "./dist/module.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abeggled/openbridgeserver.git",
    "directory": "matter"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "files": [
    "dist",
    "*.config.json",
    "*.schema.json"
  ],
  "scripts": {
    "link": "npm link --no-fund --no-audit matterbridge",
    "unlink": "npm unlink matterbridge",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
